# =============================================================================
# GEP Partner System Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit actual credentials to version control

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Your Supabase project URL and keys
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# FRONTEND CONFIGURATION (React App)
# =============================================================================
# These variables are used by the React frontend
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
REACT_APP_API_URL=http://localhost:3001
REACT_APP_ENVIRONMENT=development

# Demo mode (for development/testing only)
REACT_APP_DEMO_MODE=false

# =============================================================================
# BACKEND CONFIGURATION (Node.js API)
# =============================================================================
# Server settings
NODE_ENV=development
PORT=3001

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@gep.com
SENDGRID_FROM_NAME=GEP Assignment System

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CORS settings
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security headers
SECURITY_HEADERS_ENABLED=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FILE=logs/app.log