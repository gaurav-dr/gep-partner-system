# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Supabase Configuration
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
REACT_APP_API_URL=http://localhost:3001

# Environment
REACT_APP_ENV=development

# Demo Mode Configuration (for development/testing only)
# Set to false in production
REACT_APP_DEMO_MODE=false
REACT_APP_DEMO_CREDENTIALS=[]

# Example demo credentials format (DO NOT USE IN PRODUCTION):
# REACT_APP_DEMO_CREDENTIALS=[{"email":"admin@example.com","password":"demo123"},{"email":"manager@example.com","password":"demo123"}]